import kotlin.collections.Map;
import kotlin.String;

CREATE TABLE IF NOT EXISTS analyticsEvent (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  timestamp INTEGER NOT NULL,
  name TEXT NOT NULL,
  params TEXT AS Map<String, String> NOT NULL
);

selectEvents:
SELECT * FROM analyticsEvent ORDER BY timestamp DESC;

insertEvent:
INSERT INTO analyticsEvent (timestamp, name, params) VALUES (?, ?, ?);

deleteEvents:
DELETE FROM analyticsEvent;

CREATE TABLE IF NOT EXISTS userProperty (
  name TEXT PRIMARY KEY NOT NULL,
  value TEXT NOT NULL,
  timestamp INTEGER NOT NULL
);

selectProperties:
SELECT * FROM userProperty ORDER BY timestamp DESC;

insertProperty:
INSERT OR REPLACE INTO userProperty (name, value, timestamp) VALUES (?, ?, ?);

deleteProperties:
DELETE FROM userProperty;
